# =============================================
# APPLICATION
# =============================================
PORT=3000
NODE_ENV=                        # development | production

# =============================================
# DATABASE (Neon PostgreSQL)
# =============================================
DATABASE_URL=                    # postgres://user:password@host:port/dbname

# =============================================
# NEON LOCAL (chỉ dùng cho development)
# =============================================
NEON_API_KEY=                    # API key từ Neon dashboard
NEON_PROJECT_ID=                 # Project ID từ Neon dashboard
NEON_BRANCH_ID=                  # Branch ID cho local dev
BRANCH_ID=                       # Giống NEON_BRANCH_ID

# =============================================
# SECURITY
# =============================================
JWT_SECRET=                      # Chuỗi random dài >= 32 ký tự
JWT_EXPIRES_IN=7d                 # Thời gian hết hạn token

# =============================================
# ARCJET (Rate limiting & Bot protection)
# =============================================
ARCJET_KEY=                      # API key từ Arcjet dashboard

# =============================================
# CORS
# =============================================
ALLOWED_ORIGINS=                 # http://localhost:5173,https://yourdomain.com
